# ============================================================
#  拾光小站 · 换行符策略
#
#  仓库里统一存 LF。原因是 deploy/ 下的 shell 脚本和 mvnw 要上传到
#  Linux 执行，一旦带上 CRLF 就会报 "/bin/bash^M: bad interpreter"。
# ============================================================

# 默认：文本文件按内容自动识别，检出时一律用 LF
* text=auto eol=lf

# Windows 专用脚本保留 CRLF
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# 二进制文件不做换行转换，避免损坏
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.mp3   binary
*.wav   binary
*.jar   binary
*.woff  binary
*.woff2 binary
