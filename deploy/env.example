# 复制成 /opt/shiguang/.env，填好真实值，然后 chmod 600
#
# 注意：等号两边不要留空格；密码里如果含 # 空格 " ' 这类字符，
# 请用双引号把整个值包起来，例如  DB_PASSWORD="a#b c"

# 生产环境：会加载 application-prod.properties（关闭公开注册、不返回异常堆栈）
SPRING_PROFILES_ACTIVE=prod

# 数据库账号（第 3 步建的那个，不要用 root）
DB_USERNAME=shiguang
DB_PASSWORD=在这里填数据库密码

# 上传的音频和封面存这里，放 jar 外面，这样更新程序不会丢文件
UPLOAD_DIR=/opt/shiguang/uploads

# 时区：必须设置，否则「每日推歌」会在错误的时间点换歌
TZ=Asia/Shanghai

# 强制登录/注册走 HTTPS：开启后，明文 HTTP 下提交密码会被直接拒绝。
# 配好 HTTPS 之后再打开；只跑 HTTP 的话开了会登不进去。
# 本地开发不用设（默认 false），直接跑 localhost:8080 不受影响。
REQUIRE_HTTPS_LOGIN=true

# 是否开放评论。备案期间需要关掉用户生成内容（UGC）时设为 false：
# 关闭后文章页只显示「评论功能已暂时关闭」，发表评论会被拒绝，历史评论也不展示。
COMMENTS_ENABLED=false

# 是否开放登录。备案审核期间设为 false，整站变成纯只读：
# 登录/注册/评论全部不可用，页面上也不留任何入口按钮（顶栏的「登录/注册」会自动消失）。
# 审核通过后改回 true 重启即可恢复后台管理。
LOGIN_ENABLED=false

# 是否开放注册。备案期间建议关掉：
# 关闭后 /user/register 返回「站点已关闭注册」，顶栏的「注册」链接也会自动隐藏。
REGISTRATION_ENABLED=false

# 想直接跑在 80 端口就取消下面这行的注释，
# 同时要给 service 加 AmbientCapabilities=CAP_NET_BIND_SERVICE
#PORT=80
