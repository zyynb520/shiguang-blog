# 复制成 /opt/shiguang/.env，填好真实值，然后 chmod 600
#
# 注意：等号两边不要留空格；密码里如果含 # 空格 " ' 这类字符，
# 请用双引号把整个值包起来，例如  DB_PASSWORD="a#b c"

# 生产环境：会加载 application-prod.properties（关闭公开注册、不返回异常堆栈）
SPRING_PROFILES_ACTIVE=prod

# 数据库账号（第 3 步建的那个，不要用 root）
DB_USERNAME=shiguang
DB_PASSWORD=在这里填数据库密码

# 上传的音频和封面存这里，放 jar 外面，这样更新程序不会丢文件
UPLOAD_DIR=/opt/shiguang/uploads

# 时区：必须设置，否则「每日推歌」会在错误的时间点换歌
TZ=Asia/Shanghai

# 想直接跑在 80 端口就取消下面这行的注释，
# 同时要给 service 加 AmbientCapabilities=CAP_NET_BIND_SERVICE
#PORT=80
